          </se:PointSymbolizer>
        </se:Rule>
        <se:Rule>
          <se:Name>Auditorio</se:Name>
          <se:Description>
            <se:Title>Auditorio</se:Title>
          </se:Description>
          <ogc:Filter xmlns:ogc="http://www.opengis.net/ogc">
            <ogc:PropertyIsEqualTo>
              <ogc:PropertyName>tipo</ogc:PropertyName>
