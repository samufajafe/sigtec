# Copiar a .env y ajustar. docker compose lo lee automáticamente.
PG_SUPERUSER=postgres
PG_SUPERPASS=postgres
SIGTEC_DB=sigtec

# Usuario "replicador" (suscripciones lógicas y pg_basebackup)
SIGTEC_REPL_PASSWORD=replica2026

# Rol "sigtec_login" que usa el complemento PyQGIS para autenticar en el central
SIGTEC_LOGIN_PASSWORD=login2026

# Contraseña de los usuarios demo (editor_<campus>, consulta_<campus>)
SIGTEC_DEMO_PASSWORD=Tec2026!

# Host con el que QGIS llega a los nodos (se guarda en auth.nodo)
SIGTEC_HOST_CLIENTE=localhost
